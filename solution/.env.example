# Crew Ops Advisor — AI layer configuration.
# Copy to solution/.env and fill in a key. Switching providers is just
# changing LLM_PROVIDER; real environment variables override this file.

LLM_PROVIDER=claude

# --- Claude (Anthropic) — https://console.anthropic.com ---
ANTHROPIC_API_KEY=
#CLAUDE_MODEL=claude-opus-5
#CLAUDE_FALLBACKS=1

# --- Sarvam — https://dashboard.sarvam.ai ---
SARVAM_API_KEY=
#SARVAM_MODEL=sarvam-105b
#SARVAM_REASONING_EFFORT=medium

# --- Shared knobs ---
#LLM_MAX_TOKENS=16000
#LLM_MAX_STEPS=16
